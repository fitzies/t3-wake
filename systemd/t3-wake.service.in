# Template. install.sh fills in @PYTHON@, @SCRIPT@ and @REPO@ and writes
# ~/.config/systemd/user/t3-wake.service.
[Unit]
Description=t3-wake: POST a webhook when T3 threads launched over MCP finish or need input
Documentation=file:@REPO@/README.md
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart="@PYTHON@" -I "@SCRIPT@" run
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
Nice=5
MemoryMax=256M

[Install]
WantedBy=default.target
